# Copy this file to `.env` (never commit `.env`) and fill in real values.

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# Park Simulator API
# ---------------------------------------------------------------
SIM_BASE_URL=http://localhost:5000/api/v1
# Credentials from the simulator settings file (Name / Password)
SIM_EMAIL=admin
SIM_PASSWORD=admin
SIM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------
# Database (Supabase Postgres)
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" URI if your network has no IPv6.
# The +psycopg suffix selects the SQLAlchemy driver.
# To switch to MySQL instead: mysql+pymysql://user:pass@host:3306/dbname
# ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------
# Auth for OUR dashboard (Admin / Operator), separate from simulator creds
# ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Seeded on first startup if no admin user exists
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
