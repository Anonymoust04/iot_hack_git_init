# Copy this file to `.env` (never commit `.env`) and fill in real values.

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------
# Park Simulator API
# ---------------------------------------------------------------
# Simulator settings.json -> "ListenAddress" + /api/v1
SIM_BASE_URL=http://127.0.0.1:9898/api/v1
# Credentials from the simulator settings file (Name / Password)
SIM_EMAIL=
SIM_PASSWORD=
SIM_TIMEOUT_SECONDS=10
# Re-read spots + gates from the simulator every N seconds (list-* calls have a simulated cost). 0 = off.
SIM_SYNC_SECONDS=10
# Close a car visit with no event for this many minutes (missed departure). > simulator MaxParkingTime.
STALE_SESSION_MINUTES=15
# A car that entered but never parked within this many minutes was sent away: close its visit.
STALE_ENTERING_MINUTES=3
# Check the MD5 Signature on every webhook (fake payments fail it). Set false only to debug.
WEBHOOK_VERIFY_SIGNATURE=true
# The simulator sends "Signature": null today. true = reject unsigned webhooks too.
WEBHOOK_REQUIRE_SIGNATURE=false
# Which barriers are entrances / exits (names from GET /list-barriers, comma-separated), shown on the dashboard
ENTRY_GATE=gate1,gate3,gate5
EXIT_GATE=gate2,gate4,gate6

# ---------------------------------------------------------------
# Database (MySQL 8 — required by the judges). Setup guide: docs/aiven-mysql-setup.md
# Values are on the Aiven service Overview page -> Connection information.
# ---------------------------------------------------------------
DB_HOST=<service>-<project>.k.aivencloud.com
DB_PORT=<port>
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=<password-from-aiven>
# Aiven CA certificate (download from the service Overview page). Enables TLS with full
# certificate verification. Leave empty ONLY for a local MySQL on your own machine.
DB_SSL_CA=certs/aiven-ca.pem
# Only used by pytest: a SEPARATE database on the same server. Tests wipe it.
TEST_DB_NAME=carpark_test
# Connections per backend process. Aiven's free plan allows only a few, and the team shares them.
DB_POOL_SIZE=3

# ---------------------------------------------------------------
# Auth for OUR dashboard (Admin / Operator), separate from simulator creds
# ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# Seeded on first startup if no admin user exists
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
